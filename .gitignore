# Datos de trabajo: exports de SAGE, bancos, ADESLAS, COBEE... NUNCA al repositorio (CLAUDE.md, segunda regla)
docs_work/migration_data/*
!docs_work/migration_data/.gitkeep
!docs_work/migration_data/README.md

# Exports tabulares, estén donde estén
*.csv
*.xlsx
*.xls
*.ods
*.xml

# Configuración local de cada máquina
.claude/settings.local.json

# Dependencias y salidas locales
node_modules/
__pycache__/

test-results/
playwright-report/
.vitest/

# Vínculo local con el proyecto de Apps Script (clasp): no se versiona
.clasp.json

# Marcas que Windows añade a los ficheros descargados
*:Zone.Identifier
